# LicitaPerú · variables de entorno
# La app las lee del entorno; no carga .env sola. En PowerShell: $env:LICITAPERU_CLAUDE_CLI = "claude"
# El .env real (si lo usas) nunca va al repositorio: está en .gitignore.

# Opcional: ruta a la CLI de Claude Code si no está en el PATH (la usa el evaluador en local).
LICITAPERU_CLAUDE_CLI=claude

# PENDIENTE para la versión publicada: el evaluador necesitará una clave de API con tope de gasto.
# ANTHROPIC_API_KEY=
